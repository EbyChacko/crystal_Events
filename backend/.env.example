# Crystal Events Backend - Local Environment Variables
# Copy this file to .env and fill in the values

# SECURITY WARNING: keep the secret key used in production secret!
SECRET_KEY=django-insecure-local-dev-key-change-me

# DEBUG mode (True for local development)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email Settings (one.com)
EMAIL_HOST=send.one.com
EMAIL_PORT=465
EMAIL_HOST_USER=info@crystaleventsie.com
EMAIL_HOST_PASSWORD=your-email-password-here
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True

# Database (Optional: defaults to production Neon Postgres if not set)
# To use a local SQLite database, uncomment the following line:
# DATABASE_URL=sqlite:///db.sqlite3
